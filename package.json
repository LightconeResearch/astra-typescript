{
  "name": "@astra-spec/sdk",
  "version": "0.2.0-rc.1",
  "description": "Native TypeScript validation, resolution and provenance checking for ASTRA 0.1.",
  "type": "module",
  "license": "BSD-3-Clause",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./reports": {
      "types": "./dist/reports/index.d.ts",
      "import": "./dist/reports/index.js",
      "default": "./dist/reports/index.js"
    },
    "./resolver": {
      "types": "./dist/resolver.d.ts",
      "import": "./dist/resolver.js",
      "default": "./dist/resolver.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "prepack": "npm run reports:check && npm run spec:check && npm run build",
    "reports:generate": "node scripts/generate-report-contract.mjs",
    "reports:check": "node scripts/generate-report-contract.mjs --check",
    "test:reports:package": "npm run build && node scripts/check-report-package.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "spec:generate": "node scripts/generate-spec-contract.mjs",
    "spec:check": "node scripts/generate-spec-contract.mjs --check",
    "test:conformance": "npm run build && node scripts/check-python-conformance.mjs && node scripts/check-python-scenarios.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "astra",
    "research",
    "reproducibility",
    "schema",
    "validation",
    "linkml",
    "scientific-computing"
  ],
  "homepage": "https://lightconeresearch.github.io/astra-typescript/",
  "repository": {
    "type": "git",
    "url": "https://github.com/LightconeResearch/astra-typescript"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
