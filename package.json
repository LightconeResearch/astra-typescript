{
  "name": "@astra-spec/sdk",
  "version": "0.1.2",
  "description": "TypeScript SDK for validating ASTRA projects and opening them as resolved data.",
  "type": "module",
  "license": "BSD-3-Clause",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run clean && npm run build",
    "schema:sync": "node scripts/sync-bundled-schema.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "astra",
    "research",
    "reproducibility",
    "schema",
    "validation",
    "linkml",
    "scientific-computing"
  ],
  "homepage": "https://lightconeresearch.github.io/astra-typescript/",
  "repository": {
    "type": "git",
    "url": "https://github.com/LightconeResearch/astra-typescript"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
