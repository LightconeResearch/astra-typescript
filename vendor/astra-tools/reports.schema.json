{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "urn:astra-tools:reports:v1",
  "title": "ASTRA public reports",
  "$comment": "Generated by scripts/generate-report-schema.py from astra.model. Do not edit.",
  "oneOf": [
    {
      "$ref": "#/$defs/ResolvedAnalysis"
    },
    {
      "$ref": "#/$defs/ValidationReport"
    },
    {
      "$ref": "#/$defs/StatusReport"
    }
  ],
  "$defs": {
    "Analysis": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "folder": {
          "type": "string"
        },
        "commit": {
          "$ref": "#/$defs/Commit"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "declares": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Input"
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Decision"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Output"
          }
        },
        "prior_insights": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Insight"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Insight"
          }
        },
        "universes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Universe"
          }
        }
      },
      "required": [
        "key",
        "folder",
        "tags",
        "declares",
        "inputs",
        "decisions",
        "outputs",
        "prior_insights",
        "findings",
        "universes"
      ]
    },
    "Bytes": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "present",
            "absent"
          ]
        },
        "kept_by": {
          "type": "string"
        }
      },
      "required": [
        "state"
      ]
    },
    "Commit": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ]
    },
    "Decision": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Option"
          }
        },
        "label": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "ref",
        "options",
        "tags"
      ]
    },
    "Diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "level": {
          "enum": [
            "error",
            "warning",
            "note"
          ]
        },
        "message": {
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/Location"
        },
        "related": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Location"
          }
        }
      },
      "required": [
        "code",
        "level",
        "message",
        "location",
        "related"
      ]
    },
    "Environment": {
      "type": "object",
      "properties": {
        "iri": {
          "type": "string"
        }
      },
      "required": [
        "iri"
      ]
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "doi": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        },
        "cites": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quote": {
          "$ref": "#/$defs/TextQuoteSelector"
        },
        "location": {
          "$ref": "#/$defs/FragmentSelector"
        },
        "artifact": {
          "type": "string"
        }
      },
      "required": []
    },
    "EvidenceStatus": {
      "type": "object",
      "properties": {
        "insight": {
          "type": "string"
        },
        "index": {
          "type": "integer"
        },
        "state": {
          "enum": [
            "unchanged",
            "stale",
            "missing"
          ]
        },
        "why": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Diagnostic"
          }
        }
      },
      "required": [
        "insight",
        "index",
        "state",
        "why"
      ]
    },
    "FragmentSelector": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string"
        },
        "conforms_to": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ]
    },
    "Generation": {
      "type": "object",
      "properties": {
        "commit": {
          "type": "string"
        },
        "environment": {
          "$ref": "#/$defs/Environment"
        },
        "runner": {
          "$ref": "#/$defs/Runner"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecordedInput"
          }
        },
        "started": {
          "type": "string"
        },
        "finished": {
          "type": "string"
        }
      },
      "required": [
        "commit",
        "environment",
        "runner",
        "inputs"
      ]
    },
    "Input": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "ref",
        "path",
        "tags"
      ]
    },
    "Insight": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "prior_insight",
            "finding"
          ]
        },
        "claim": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "ref",
        "kind",
        "claim",
        "evidence",
        "tags"
      ]
    },
    "Location": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "pointer": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        },
        "column": {
          "type": "integer"
        },
        "key": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "file",
        "pointer"
      ]
    },
    "Option": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded": {
          "type": "string"
        },
        "insights": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "tags",
        "insights"
      ]
    },
    "Output": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resources": {
          "$ref": "#/$defs/Resources"
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "ref",
        "type",
        "format",
        "tags",
        "decisions"
      ]
    },
    "Place": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string"
        },
        "record_path": {
          "type": "string"
        },
        "file_path": {
          "type": "string"
        }
      },
      "required": [
        "address",
        "record_path",
        "file_path"
      ]
    },
    "ProvenanceRecord": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string"
        },
        "content_hash": {
          "type": "string"
        },
        "size": {
          "type": "integer"
        },
        "generated_by": {
          "$ref": "#/$defs/Generation"
        },
        "spec_version": {
          "type": "string"
        }
      },
      "required": [
        "address",
        "content_hash",
        "size",
        "generated_by",
        "spec_version"
      ]
    },
    "RecordedInput": {
      "type": "object",
      "properties": {
        "entry": {
          "type": "string"
        },
        "content_hash": {
          "type": "string"
        },
        "size": {
          "type": "integer"
        }
      },
      "required": [
        "entry",
        "content_hash",
        "size"
      ]
    },
    "ResolvedAnalysis": {
      "type": "object",
      "properties": {
        "spec_version": {
          "type": "string"
        },
        "head": {
          "type": "string"
        },
        "analyses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Analysis"
          }
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Result"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Diagnostic"
          }
        },
        "schema_version": {
          "const": "astra-tools.resolved-analysis.v1"
        }
      },
      "required": [
        "spec_version",
        "analyses",
        "results",
        "notes",
        "schema_version"
      ]
    },
    "Resources": {
      "type": "object",
      "properties": {
        "cpus": {
          "type": "number"
        },
        "memory": {
          "type": "string"
        },
        "time_limit": {
          "type": "string"
        },
        "disk": {
          "type": "string"
        },
        "gpus": {
          "type": "integer"
        }
      },
      "required": []
    },
    "Result": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "places": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Place"
          }
        },
        "universe": {
          "type": "string"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Source"
          }
        },
        "command": {
          "type": "string"
        },
        "commit": {
          "$ref": "#/$defs/Commit"
        }
      },
      "required": [
        "id",
        "output",
        "places",
        "inputs"
      ]
    },
    "Runner": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "Source": {
      "type": "object",
      "properties": {
        "entry": {
          "type": "string"
        },
        "input": {
          "type": "string"
        },
        "result": {
          "type": "string"
        }
      },
      "required": [
        "entry"
      ]
    },
    "Status": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "unchanged",
            "stale",
            "missing"
          ]
        },
        "bytes": {
          "$ref": "#/$defs/Bytes"
        },
        "record": {
          "$ref": "#/$defs/ProvenanceRecord"
        },
        "why": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Diagnostic"
          }
        },
        "stale_inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "state",
        "why",
        "stale_inputs"
      ]
    },
    "StatusReport": {
      "type": "object",
      "properties": {
        "head": {
          "type": "string"
        },
        "statuses": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Status"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceStatus"
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Bytes"
          }
        },
        "schema_version": {
          "const": "astra-tools.status-report.v1"
        }
      },
      "required": [
        "statuses",
        "evidence",
        "inputs",
        "schema_version"
      ]
    },
    "TextQuoteSelector": {
      "type": "object",
      "properties": {
        "exact": {
          "type": "string"
        },
        "prefix": {
          "type": "string"
        },
        "suffix": {
          "type": "string"
        }
      },
      "required": [
        "exact"
      ]
    },
    "Universe": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string"
        },
        "selection": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "ref",
        "selection",
        "tags"
      ]
    },
    "ValidationReport": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string"
        },
        "valid": {
          "type": "boolean"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Diagnostic"
          }
        },
        "unchecked": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "schema_version": {
          "const": "astra-tools.validation-report.v1"
        }
      },
      "required": [
        "root",
        "valid",
        "diagnostics",
        "unchecked",
        "schema_version"
      ]
    }
  }
}
